  },
  "tipo": {
   "enum": [
    "computacion",
    "propiedad",
    "candidata",
    "candidata-lang"
   ]
  }
 },
 "required": [
  "ambito",
  "esquema",
  "id",
  "nombre",
  "tipo"
 ],
 "then": {
  "properties": {
   "ambito": {
    "maxLength": 64,
    "pattern": "^[0-9a-f]{64}$",
    "type": "string"
   }
  }
 },
 "title": "ranura",
 "type": "object"
}
